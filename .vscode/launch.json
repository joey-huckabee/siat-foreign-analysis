{
  // The three paths default to values relative to the working directory, so
  // every configuration sets `cwd` to the workspace folder. Running from
  // anywhere else finds no input and writes an empty report; pass --input and
  // --output explicitly to work against a scan somewhere else.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Foreign analysis",
      "type": "debugpy",
      "request": "launch",
      "module": "siat_foreign_analysis",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Foreign analysis: verbose",
      "type": "debugpy",
      "request": "launch",
      "module": "siat_foreign_analysis",
      "args": ["--verbose"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Foreign analysis: step into dependencies",
      "type": "debugpy",
      "request": "launch",
      "module": "siat_foreign_analysis",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      // Lets you step into the standard library when the bug is not ours.
      "justMyCode": false
    },
    {
      "name": "Foreign analysis: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}

{
  // The script resolves `input/` and `output/` relative to the working
  // directory, so every configuration sets `cwd` to the workspace folder.
  // Running it from anywhere else silently finds no input and writes an
  // empty report.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Foreign analysis",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/foreign_analysis.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Foreign analysis: step into dependencies",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/foreign_analysis.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      // Lets you step into the standard library when the bug is not ours.
      "justMyCode": false
    },
    {
      "name": "Foreign analysis: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}

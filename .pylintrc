[MAIN]
py-version = 3.10
jobs = 0
ignore-paths = ^\.venv/.*$
load-plugins =
    pylint.extensions.docparams,
    pylint.extensions.no_self_use

[MESSAGES CONTROL]
# Disabled where black / ruff / mypy already own the concern, plus a few
# rules that fight normal application code.
disable =
    line-too-long,
    wrong-import-order,
    ungrouped-imports,
    missing-type-doc,
    missing-return-type-doc,
    too-few-public-methods,
    duplicate-code,
    fixme,
    # A pytest fixture is consumed by a parameter of the same name, so
    # every test using a locally-defined fixture trips this.
    redefined-outer-name,
    # `assert discover_inputs(...) == []` asserts the type as well as the
    # emptiness. `assert not discover_inputs(...)` passes on None, on 0 and
    # on "", none of which the function may return. The comparison is the
    # stronger assertion and is deliberate in tests.
    use-implicit-booleaness-not-comparison

[FORMAT]
max-line-length = 100

[BASIC]
good-names = i, j, k, n, x, y, db, id, ok, pr, gh, _
# Private helpers document themselves by name.
no-docstring-rgx = ^(_|test_)

[DESIGN]
max-args = 8
max-positional-arguments = 8
max-attributes = 16
max-locals = 24
max-module-lines = 1000

[REPORTS]
score = no
